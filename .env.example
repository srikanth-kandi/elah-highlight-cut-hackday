# Google Gemini API Key configuration for Elah Highlight Cut Studio
# Duplicate this file to .env and set your Google Gemini API Key below:

VITE_GEMINI_API_KEY=your_google_gemini_api_key_here
# Alternative environment variable names:
# VITE_GOOGLE_API_KEY=your_google_gemini_api_key_here
# VITE_ELAH_API_KEY=your_google_gemini_api_key_here
